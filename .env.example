# OpenGate CLI environment variables
# Copy to .env and fill in your values. .env is gitignored — never commit real secrets.
# Each var overrides the matching config-file setting for the active profile.

# Connection
# OG_HOST=https://api.opengate.es
# OG_PROFILE=default
# OG_ORG=

# Authentication (alternative to `og login`)
# OG_EMAIL=
# OG_PASSWORD=
# OG_TOKEN=
# OG_WEB_TOKEN=       # separate web JWT for workspace/dashboard operations

# 2FA / TOTP (for accounts with 2FA enabled)
# OG_2FA_CODE=        # a single 6-digit code (expires in 30s)
# OG_2FA_SECRET=      # base32 seed — og derives the code itself (hands-off)

# TLS (self-signed / private-CA servers)
# OG_INSECURE=false
# OG_CA_FILE=
